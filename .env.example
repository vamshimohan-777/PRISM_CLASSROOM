# --- Frontend -------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api

# --- Backend --------------------------------------------------------------
DATABASE_URL=sqlite:///./prism.db

# Exact origins allowed to call the API cross-origin (comma-separated).
# The unified container serves the SPA same-origin and needs none of these.
CORS_ORIGINS=http://localhost:5173
# Optional regex alternative. Scope it to your own subdomain -- never to a
# whole shared host such as https://.*\.onrender\.com
# CORS_ORIGIN_REGEX=

# Bearer-token signing secret. Required when PRISM_DEMO_MODE=0.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# PRISM_AUTH_SECRET=

# 1 = public demo conveniences on (persona endpoints, X-Demo-Teacher header,
#     POST /api/demo/reset). Default.
# 0 = production: those endpoints return 404 and PRISM_AUTH_SECRET is required.
PRISM_DEMO_MODE=1

# Optional: enables the Gemini fallback in the Answer Engine.
# Leave unset to use the deterministic solver only.
# GEMINI_API_KEY=
